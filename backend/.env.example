# RescueRoute Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Replace with your credentials)
MONGODB_URI=mongodb://localhost:27017/rescueroute

# Authentication
JWT_SECRET=replace_with_new_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS - Allowed Frontend Origin
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Matching Engine Configuration
MATCH_MAX_DISTANCE_KM=50
MATCH_RESULT_LIMIT=10

# AI Configuration (Gemini API)
# Server-side only; never expose to client or commit actual keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_MAX=20
